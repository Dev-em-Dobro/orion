# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/

# next.js
/.next/
# Diretórios de build isolados: `.next-dev` (o `next dev`), `.next-perf` e
# `.next-shots` (scripts de medição), `.next-build` (build de conferência).
# Existem pra não reescreverem uns aos outros — ver `distDir` em next.config.ts.
#
# O glob cobre os que ainda vão existir: nomear um por um deixou `.next-build`
# de fora, e um `git add -A` distraído levou 454 arquivos de artefato pro índice.
/.next-*/
/out/
next-env.d.ts

# production
/build

# misc
.DS_Store
*.pem
Thumbs.db

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (mantenha .env.example versionado)
.env
.env*.local
.env.development
.env.production

# vercel
.vercel

# typescript
*.tsbuildinfo

# prisma
/prisma/migrations/dev.db*
/prisma/*.db
/prisma/*.db-journal

# editor / IDE
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/

# claude code (config local, per-máquina)
.claude/settings.local.json

# logs
logs
*.log

# python (skills)
__pycache__/
*.pyc

.vercel

# gstack — estado local da ferramenta (logs de browse, cache de disponibilidade).
.gstack/

# Projetos vizinhos clonados na mesma pasta — não fazem parte do Orion.
# Sem isto o `tsc`/`next build` engole o TypeScript deles via include `**/*.ts`.
/arena-dobro/
/comunidade-builders-club/
