DATABASE_URL=sua_connection_string_aqui

# F016 / ADR-009 — chave-mestra BYOK (32 bytes em base64). Gere com:
#   openssl rand -base64 32
# Sem ela o app não cifra/decifra as chaves do aluno.
BYOK_MASTER_KEY=

# F018 — chaves compartilhadas da Orion (modo padrão dos alunos).
# Usadas quando key_mode = orion em UserApiKeys.
ORION_GOOGLE_API_KEY=
ORION_OPENAI_API_KEY=

# F019 — webhook Hubla. Elite e PRO Club abrem o Orion (PRO = plano Free).
# Token: Integrações → Webhook → Autenticação → Hubla Webhook Token
HUBLA_WEBHOOK_TOKEN=
# Legado Elite (produto antigo R$ 997) — concede acesso
HUBLA_PRODUCT_ID=VL3e0iDO3A32SyjJWr9S
# Produto Elite novo (R$ 997), quando a Hubla tiver o id
# HUBLA_PRODUCT_ID_ELITE=
# PRO Club R$ 297 — acesso Orion no plano Free. NÃO é HUBLA_PRODUCT_ID_PRO.
# HUBLA_PRODUCT_ID_CLUB_PRO=
# Checkout Elite — link em /ativar-acesso
HUBLA_CHECKOUT_URL=https://pay.hub.la/v1SsMcVXNip7Mn5A2pNH

# F041 — webhook TMB. Elite = cortesia Pro; Mentoria 1AS = acesso Free
# Na UI TMB: Chave = x-tmb-token (ou TMB_WEBHOOK_HEADER), Valor = token
TMB_WEBHOOK_TOKEN=
# TMB_WEBHOOK_HEADER=x-tmb-token
# TMB_ELITE_CODES=3XB272209KV,9DW254247E5
# TMB_LANCAMENTO_ID=36238

# F035 — planos. `product_id` de cada plano na Hubla (aceita lista separada por
# vírgula, pra migrar de oferta sem quebrar quem já assinou). Vazio = todo mundo
# no plano Free, que é o comportamento correto enquanto não existe plano pago.
HUBLA_PRODUCT_ID_PRO=
HUBLA_PRODUCT_ID_AGENCIA=
# Cortesia Pro no Elite novo: só dispara se HUBLA_PRODUCT_ID_PRO começar com
# trial-pro-. Default 90 dias por aluno (expires_at). Grants futuros: 30.
# CORTESIA_PRO_DIAS=90
# Checkout de cada plano, exibido em /planos. Vazio = botão "em breve".
HUBLA_CHECKOUT_URL_PRO=
HUBLA_CHECKOUT_URL_AGENCIA=

# Chaves de API do aluno: configure em /configuracao (modo BYOK). As vars abaixo
# NÃO são mais lidas pelas features — ficam só como referência / migração local.
# ANTHROPIC_API_KEY=
# GOOGLE_PLACES_API_KEY=
# PAGESPEED_API_KEY=
# SCREENSHOTONE_ACCESS_KEY=

# F014 — autenticação (Better Auth). Sem default: ausência → erro no boot
# e GET /api/health → 503. Gere: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Produção: BETTER_AUTH_URL=https://orion-lead-hunter.devemdobro.com
# Google OAuth — opcional. Ambos ou nenhum (sem meio-termo).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# F014 / ADR-010 — e-mail do magic link
# Local: docker compose up -d  → UI http://127.0.0.1:8025
EMAIL_PROVIDER=mailpit
EMAIL_FROM=orion-lead-hunter@localhost
MAILPIT_URL=http://127.0.0.1:8025
# Produção (Resend SMTP):
# EMAIL_PROVIDER=resend
# Nome de exibição + endereço (Gmail: "Orion Lead Hunter <noreply@…>"):
# RESEND_SMTP_FROM_EMAIL="Orion Lead Hunter <noreply@devemdobro.com>"
# RESEND_SMTP_HOST=smtp.resend.com
# RESEND_SMTP_PORT=465
# RESEND_SMTP_USER=resend
# RESEND_SMTP_PASS=

# Observabilidade (ADR-013) — Sentry. Sem DSN ⇒ no-op.
# NEXT_PUBLIC_SENTRY_DSN=   # browser (mesmo valor do DSN do projeto)
# SENTRY_DSN=               # server/edge (pode ser o mesmo)
# SENTRY_ENVIRONMENT=production
# Upload de source maps no CI (opcional):
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=

# F035 — BYOK encerrado para novos alunos (2026-08-13). "1" reabre.
BYOK_NOVOS_ALUNOS=0

# F035 — chave de API do Google para o Orion Lead Hunter
ORION_GOOGLE_API_KEY=xxxxxxxxxx
